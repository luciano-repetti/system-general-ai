{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "system-general-ai",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Task",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "Agent",
      "Skill",
      "ToolSearch",
      "ScheduleWakeup",
      "PushNotification",
      "EnterPlanMode",
      "ExitPlanMode",
      "EnterWorktree",
      "ExitWorktree",
      "Monitor",
      "NotebookEdit",
      "AskUserQuestion",
      "mcp__*"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(*:|:*)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --force*)",
      "Bash(git push origin -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fdx*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -D master*)"
    ]
  }
}

