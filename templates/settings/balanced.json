{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "system-general-ai",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Task",
      "TaskCreate",
      "TaskUpdate",
      "TaskGet",
      "TaskList",
      "Skill",
      "ToolSearch",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(ls*)",
      "Bash(pwd)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(echo*)",
      "Bash(which*)",
      "Bash(env)",
      "Bash(printenv*)",
      "mcp__plugin_engram_engram__mem_*"
    ],
    "ask": [
      "Edit",
      "Write",
      "Bash",
      "WebFetch",
      "WebSearch",
      "Agent",
      "EnterWorktree",
      "ExitWorktree",
      "NotebookEdit"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(*:|:*)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --force*)",
      "Bash(git push origin -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fdx*)",
      "Bash(git branch -D main*)",
      "Bash(git branch -D master*)"
    ]
  }
}

